---
import SlantButton from './SlantButton.astro';
import { SITE } from '../data/site';

const nav = [
  { label: 'TOP',      href: '/'         },
  { label: '会社概要',  href: '/company'  },
  { label: '製品一覧',  href: '/products' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white transition-shadow duration-300"
>
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">

    <!-- ロゴ -->
    <a href="/" class="leading-tight group">
      <span class="font-serif text-dark text-base font-semibold tracking-wide group-hover:text-primary transition-colors">
        {SITE.name}
      </span>
    </a>

    <!-- デスクトップナビ -->
    <nav class="hidden md:flex items-center gap-8">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'text-sm tracking-wider transition-colors duration-200',
            currentPath === href
              ? 'text-primary font-medium'
              : 'text-dark/70 hover:text-dark',
          ]}
        >
          {label}
        </a>
      ))}
      <div class="ml-4">
        <SlantButton text="お問い合わせ" href={`mailto:${SITE.email}`} />
      </div>
    </nav>

    <!-- モバイルメニューボタン -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="メニューを開く"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-dark transition-all" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-dark transition-all" id="bar2"></span>
      <span class="block w-6 h-0.5 bg-dark transition-all" id="bar3"></span>
    </button>
  </div>

  <!-- モバイルメニュー -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-white border-t border-dark/10"
  >
    <nav class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-4">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'text-sm tracking-wider py-2 border-b border-dark/10',
            currentPath === href ? 'text-primary' : 'text-dark/70',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href={`mailto:${SITE.email}`}
        class="mt-2 bg-primary text-white text-sm text-center px-4 py-3"
      >
        お問い合わせ
      </a>
    </nav>
  </div>
</header>

<script>
  // スクロール量が50pxを超えたら shadow-md を追加
  const header = document.getElementById('site-header')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.add('shadow-md');
    } else {
      header.classList.remove('shadow-md');
    }
  }, { passive: true });

  // ハンバーガーメニュー開閉
  const btn  = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;
  const bar3 = document.getElementById('bar3')!;

  btn.addEventListener('click', () => {
    const isHidden = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isHidden));
    bar1.classList.toggle('rotate-45');
    bar1.classList.toggle('translate-y-2');
    bar2.classList.toggle('opacity-0');
    bar3.classList.toggle('-rotate-45');
    bar3.classList.toggle('-translate-y-2');
  });
</script>
