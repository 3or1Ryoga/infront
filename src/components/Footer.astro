---
import { SITE } from '../data/site';

const nav = [
  { label: 'TOP',      href: '/'         },
  { label: '会社概要',  href: '/company'  },
  { label: '製品一覧',  href: '/products' },
];
---

<footer class="bg-dark text-white">
  <div class="max-w-6xl mx-auto px-6 py-16">

    <!-- 上段 -->
    <div class="flex flex-col md:flex-row justify-between gap-12">

      <!-- 左: 社名 + ナビリンク -->
      <div>
        <p class="font-serif text-lg font-semibold mb-1">{SITE.name}</p>
        <p class="text-white/40 text-xs tracking-widest uppercase mb-6">{SITE.nameEn}</p>
        <nav class="flex flex-col gap-3">
          {nav.map(({ label, href }) => (
            <a href={href} class="text-sm text-white/70 hover:text-white transition-colors">
              {label}
            </a>
          ))}
        </nav>
      </div>

      <!-- 右: TEL + メール -->
      <div class="flex flex-col gap-4">
        <a
          href={SITE.telHref}
          class="flex flex-col gap-1 group"
        >
          <span class="text-white/40 text-xs tracking-widest uppercase">Phone</span>
          <span class="font-serif text-2xl tracking-wider group-hover:text-primary transition-colors">
            {SITE.tel}
          </span>
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="flex flex-col gap-1 group"
        >
          <span class="text-white/40 text-xs tracking-widest uppercase">Email</span>
          <span class="text-sm text-white/70 group-hover:text-white transition-colors">
            {SITE.email}
          </span>
        </a>
        <p class="text-sm text-white/60 mt-2">{SITE.address}</p>
      </div>
    </div>

    <!-- 下段: コピーライト -->
    <div class="mt-12 pt-6 border-t border-white/10 text-center text-xs text-white/30">
      {SITE.copyright}
    </div>
  </div>
</footer>
