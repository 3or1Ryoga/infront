---
interface Props {
  text:      string;
  href:      string;
  external?: boolean;
  variant?:  'default' | 'onDark';
}

const { text, href, external = false, variant = 'default' } = Astro.props;
const isOnDark = variant === 'onDark';
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'slant-button group relative inline-flex items-center justify-center overflow-hidden px-8 py-3 min-w-[200px]',
    isOnDark ? 'bg-white' : 'bg-dark',
  ]}
>
  <!-- 赤レイヤー: clip-path で左80%を覆い、ホバー時に左へワイプして消える -->
  <span class="slant-red absolute inset-0 bg-primary" aria-hidden="true"></span>

  <!-- テキスト: onDark はホバー後に白背景になるため dark に切り替え -->
  <span
    class:list={[
      'relative z-10 font-semibold text-sm tracking-wider transition-colors duration-300',
      isOnDark
        ? 'text-white group-hover:text-dark'
        : 'text-white',
    ]}
  >
    {text}
  </span>
</a>
