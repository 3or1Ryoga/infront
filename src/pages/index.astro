---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SlantButton from '../components/SlantButton.astro';
import { SITE } from '../data/site';

const productCategories = [
  {
    num: '01',
    en:  'Abrasive Materials',
    ja:  '研削材料・研磨材',
    href: '/products#研削材料',
  },
  {
    num: '02',
    en:  'Ceramics Raw Materials',
    ja:  'セラミックス原材料',
    href: '/products#セラミックス原材料',
  },
  {
    num: '03',
    en:  'Industrial Sub-Materials',
    ja:  '工業用副資材',
    href: '/products#工業用副資材',
  },
];
---

<Layout>
  <!-- ==============================
       Section 1: Hero
  ============================== -->
  <section class="min-h-screen flex items-center bg-dark">
    <div class="max-w-6xl mx-auto px-6 md:px-16 py-32">
      <p class="text-primary text-sm tracking-widest uppercase">About us</p>
      <h1 class="font-serif text-white text-4xl md:text-6xl leading-tight mt-4">
        独自の技術と品質で、<br />
        研磨材料の未来を切り開く
      </h1>
      <p class="text-white opacity-80 mt-6 text-base md:text-lg max-w-xl leading-relaxed">
        国内外の厳選素材を、卓越した品質管理でご提供いたします。
      </p>
      <div class="mt-10">
        <SlantButton text="製品一覧を見る" href="/products" variant="onDark" />
      </div>
    </div>
  </section>

  <!-- ==============================
       Section 2: About
  ============================== -->
  <section class="bg-off-white py-20 px-6 md:px-16">
    <div class="max-w-6xl mx-auto">
      <SectionLabel en="About us" ja="インフロント興産について" />
      <div class="mt-8 max-w-2xl space-y-4 text-dark/70 leading-relaxed">
        <p>
          株式会社インフロント興産は、研磨材・ブラスト材・セラミックス原材料・工業用副資材を専門に取り扱う商社です。
          製鉄・機械加工・精密部品など多岐にわたる製造業のお客様へ、最適な素材を安定的にご提供することを使命としています。
        </p>
        <p>
          長年の経験と豊富な業界ネットワークを活かし、品質・コスト・納期のすべてにおいてご満足いただける提案を追求してまいります。
          小ロットから大口取引まで柔軟に対応し、お客様の生産現場を確実に支えます。
        </p>
      </div>
      <div class="mt-10">
        <SlantButton text="会社概要を見る" href="/company" />
      </div>
    </div>
  </section>

  <!-- ==============================
       Section 3: Products
  ============================== -->
  <section class="bg-light py-20 px-6 md:px-16">
    <div class="max-w-6xl mx-auto">
      <SectionLabel en="Products" ja="取り扱い製品カテゴリ" />
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
        {productCategories.map(({ num, en, ja, href }) => (
          <a
            href={href}
            class="border border-gray-200 p-8 transition-colors duration-200 hover:border-primary"
          >
            <p class="font-serif text-4xl text-primary">{num}</p>
            <p class="text-xs tracking-widest text-gray-400 mt-1 uppercase">{en}</p>
            <p class="font-serif text-xl mt-2 text-dark">{ja}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==============================
       Section 4: Sustainability
  ============================== -->
  <section class="bg-dark py-20 px-6 md:px-16 text-white text-center">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-serif text-white text-3xl md:text-4xl">
        持続可能な社会の実現に向けて
      </h2>
      <p class="text-white opacity-80 max-w-2xl mx-auto mt-6 leading-relaxed">
        当社は資源の有効活用とリサイクル素材の積極的な採用を通じて、環境負荷の低減に取り組んでいます。
        お客様の製造プロセスにおける廃棄物削減や省エネルギー化を支援する素材提案を行い、
        持続可能なものづくりの実現に貢献してまいります。
      </p>
    </div>
  </section>

  <!-- ==============================
       Section 5: Contact CTA
  ============================== -->
  <section class="bg-off-white py-20 px-6 md:px-16">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="font-serif text-2xl md:text-3xl text-dark">
        お問い合わせはお電話・メールにて承ります
      </h2>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <SlantButton text="お電話でのお問い合わせ" href={SITE.telHref} />
        <SlantButton text="メールでのお問い合わせ" href={`mailto:${SITE.email}`} />
      </div>
    </div>
  </section>
</Layout>
