---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SlantButton from '../components/SlantButton.astro';
import { SITE } from '../data/site';
import productsData from '../data/products.json';

const categories = [
  { id: 'abrasive',   label: '01 研削材料・研磨材',    value: '研削材料'          },
  { id: 'ceramics',   label: '02 セラミックス原材料',   value: 'セラミックス原材料' },
  { id: 'industrial', label: '03 工業用副資材',         value: '工業用副資材'       },
];
---

<Layout title="製品一覧" description={`${SITE.name}が取り扱う研磨材・工業材料の製品一覧です。`}>

  <!-- ページヘッダー -->
  <section class="bg-dark py-20 px-6 md:px-16">
    <div class="max-w-6xl mx-auto">
      <p class="text-primary text-sm tracking-widest">Products</p>
      <h1 class="font-serif text-white text-4xl md:text-5xl mt-2">製品一覧</h1>
      <p class="text-white text-sm opacity-60 mt-4">
        <a href="/" class="hover:opacity-100 transition-opacity">TOP</a>
        <span class="mx-2">›</span>
        製品一覧
      </p>
    </div>
  </section>

  <!-- カテゴリアンカーナビ -->
  <div class="bg-off-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-2 md:px-16 grid grid-cols-3 gap-0">
      {categories.map(({ id, label }) => (
        <a
          href={`#${id}`}
          class="min-w-0 px-1 sm:px-3 md:px-6 py-4 text-[11px] sm:text-xs md:text-sm leading-snug text-center font-medium text-dark/60 border-b-2 border-transparent hover:border-primary hover:text-primary transition-colors duration-200"
        >
          {label}
        </a>
      ))}
    </div>
  </div>

  <!-- 製品リスト -->
  <div class="bg-light">
    {categories.map((category) => (
      <section id={category.id} class="scroll-mt-16 py-16 px-6 md:px-16">
        <div class="max-w-6xl mx-auto">
          <h2 class="font-serif text-2xl border-b-2 border-primary pb-3 mb-10">
            {category.label}
          </h2>

          {productsData
            .filter((p) => p.category === category.value)
            .map((product) => (
              <article class="flex flex-col md:flex-row gap-8 py-12 border-b border-gray-200">

                <!-- 左: 画像エリア -->
                <div class="md:w-[280px] md:shrink-0">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="w-full aspect-[4/3] object-cover"
                    loading="lazy"
                    onerror="this.onerror=null;this.src='/images/products/placeholder.jpg'"
                  />
                </div>

                <!-- 右: テキスト + スペック -->
                <div class="flex-1">
                  <h3 class="font-serif text-xl border-b border-gray-200 pb-3 mb-4">
                    ■ {product.name}　[{product.code}]
                  </h3>

                  <p class="text-sm text-gray-600 mb-6">{product.description}</p>

                  <dl class="text-sm space-y-3">

                    <!-- 粒度 -->
                    {product.specs.granularity && (
                      <div class="flex gap-4 border-b border-gray-100 pb-3">
                        <dt class="font-semibold text-gray-500 min-w-[80px] shrink-0">粒度</dt>
                        <dd>{product.specs.granularity}</dd>
                      </div>
                    )}

                    <!-- 分析値 -->
                    <div class="border-b border-gray-100 pb-3">
                      <dt class="font-semibold text-gray-500 mb-2">分析値</dt>
                      <dd>
                        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-1">
                          {product.specs.analysis.map((item) => (
                            <div class="flex gap-2">
                              <dt class="text-gray-500">{item.label}</dt>
                              <dd>{item.value}</dd>
                            </div>
                          ))}
                        </dl>
                      </dd>
                    </div>

                    <!-- 嵩比重 -->
                    {product.specs.bulk_density && (
                      <div class="flex gap-4 border-b border-gray-100 pb-3">
                        <dt class="font-semibold text-gray-500 min-w-[80px] shrink-0">嵩比重</dt>
                        <dd>{product.specs.bulk_density}</dd>
                      </div>
                    )}

                    <!-- 補足 -->
                    {product.specs.notes && (
                      <p class="text-xs text-gray-400 mt-2">{product.specs.notes}</p>
                    )}

                  </dl>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    ))}
  </div>

  <!-- Contact CTA -->
  <section class="bg-off-white py-20 px-6 md:px-16">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="font-serif text-2xl md:text-3xl text-dark">
        お問い合わせはお電話・メールにて承ります
      </h2>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <SlantButton text="お電話でのお問い合わせ" href={SITE.telHref} />
        <SlantButton text="メールでのお問い合わせ" href={`mailto:${SITE.email}`} />
      </div>
    </div>
  </section>

</Layout>
