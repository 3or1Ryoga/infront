---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SlantButton from '../components/SlantButton.astro';
import { SITE } from '../data/site';

const companyInfo = [
  { label: '商号',     value: SITE.name },
  { label: '英語表記', value: SITE.nameEn },
  { label: '設立',     value: '2010年（仮）' },
  { label: '資本金',   value: '1,000万円（仮）' },
  { label: '代表者',   value: '代表取締役 ○○ ○○（仮）' },
  { label: '所在地',   value: SITE.address },
  { label: '事業内容', value: '研磨材料・工業材料の製造・販売' },
];
---

<Layout title="会社概要" description={`${SITE.name}の会社概要・沿革・アクセスをご紹介します。`}>

  <!-- ページヘッダー -->
  <section class="bg-dark py-20 px-6 md:px-16">
    <div class="max-w-6xl mx-auto">
      <p class="text-primary text-sm tracking-widest">Company</p>
      <h1 class="font-serif text-white text-4xl md:text-5xl mt-2">会社概要</h1>
      <p class="text-white text-sm opacity-60 mt-4">
        <a href="/" class="hover:opacity-100 transition-opacity">TOP</a>
        <span class="mx-2">›</span>
        会社概要
      </p>
    </div>
  </section>

  <!-- Section 1: 会社概要テーブル -->
  <section class="bg-off-white py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto">
      <SectionLabel en="Company Profile" ja="会社概要" />
      <dl class="mt-10 divide-y divide-gray-100">
        {companyInfo.map(({ label, value }) => (
          <div class="flex flex-col sm:flex-row py-4 border-b border-gray-100">
            <dt class="text-sm font-semibold text-gray-500 min-w-[140px] shrink-0">{label}</dt>
            <dd class="text-dark mt-1 sm:mt-0">{value}</dd>
          </div>
        ))}
        <div class="flex flex-col sm:flex-row py-4 border-b border-gray-100">
          <dt class="text-sm font-semibold text-gray-500 min-w-[140px] shrink-0">電話番号</dt>
          <dd class="text-dark mt-1 sm:mt-0">
            <a href={SITE.telHref} class="hover:text-primary transition-colors">{SITE.tel}</a>
          </dd>
        </div>
        <div class="flex flex-col sm:flex-row py-4 border-b border-gray-100">
          <dt class="text-sm font-semibold text-gray-500 min-w-[140px] shrink-0">メール</dt>
          <dd class="text-dark mt-1 sm:mt-0">
            <a href={`mailto:${SITE.email}`} class="hover:text-primary transition-colors">{SITE.email}</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Section 2: アクセス -->
  <section class="bg-light py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto">
      <SectionLabel en="Access" ja="所在地・アクセス" />
      <div class="mt-10">
        <iframe
          src="https://maps.google.com/maps?q=大阪市&output=embed"
          width="100%"
          height="400"
          class="border-0 w-full"
          loading="lazy"
          title="アクセスマップ"
        ></iframe>
        <p class="mt-4 text-dark/70 text-sm">{SITE.address}</p>
      </div>
    </div>
  </section>

  <!-- Section 3: Contact CTA -->
  <section class="bg-off-white py-20 px-6 md:px-16">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="font-serif text-2xl md:text-3xl text-dark">
        お問い合わせはお電話・メールにて承ります
      </h2>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <SlantButton text="お電話でのお問い合わせ" href={SITE.telHref} />
        <SlantButton text="メールでのお問い合わせ" href={`mailto:${SITE.email}`} />
      </div>
    </div>
  </section>

</Layout>
